    <string name="settings_wake_words_none">Nothing set yet; the default is %1$s</string>
    <string name="settings_wake_words_now">Now: %1$s</string>
    <string name="settings_wake_words_summary">One word per line, written as word=pinyin with tone numbers, for example 大肥鱼大肥鱼=da4 fei2 yu2 da4 fei2 yu2. The pinyin becomes the symbols the model knows, and anything missing from its table is refused instead of dropped quietly</string>
    <string name="settings_wake_words_saved">Saved: %1$s</string>
    <string name="settings_wake_words_unsaved">Not saved: %1$s</string>
    <string name="settings_wake_allow">Allow the wake word</string>
    <string name="settings_wake_allow_summary">Let this app listen for the wake word (a local 3.3M keyword model, 5.3 MB). It is only permission: the microphone starts guarding that word once this is on, and the notification keeps a Stop button</string>
    <string name="settings_wake_voice">Keep the voice chain resident</string>
    <string name="settings_wake_voice_summary">On: the microphone stays open after a hit (the 240 MB on-device SenseVoice model comes into memory then), so you can keep talking. Off: each wake still buys one sentence - the chain closes again once you have said it, and the model goes back with it</string>
    <string name="settings_wake_need_model">The wake word model is not downloaded yet; the download row below is what gets it</string>
    <string name="settings_wake_action">After a hit</string>
    <string name="settings_wake_action_summary">What a hit does beyond buzzing, beeping and bringing the app forward. The two mode rows go through the same command path as saying it out loud, and that table lives on the host side in one place</string>
    <string name="settings_wake_action_wake">Just wake (one sentence)</string>
    <string name="settings_wake_action_video">Also switch to video mode</string>
    <string name="settings_wake_action_phone">Also switch back to phone mode</string>
    <string name="settings_wake_vibrate">Buzz on a hit</string>
    <string name="settings_wake_vibrate_summary">A 200 ms buzz when the word is heard; off leaves the short beep, and the app still comes forward</string>
